# Release signing config for Wakify.
#
# 1. Generate a private release keystore (do NOT commit it):
#      keytool -genkeypair -v -keystore android/app/release.keystore \
#        -alias wakify -keyalg RSA -keysize 2048 -validity 10000
# 2. Copy this file to  android/keystore.properties  and fill in the values.
#
# Both the real keystore.properties and *.keystore (except debug.keystore) are
# gitignored, so no signing key or password ever enters the repo. Without this
# file, release builds fall back to the debug key (fine for local testing only).

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=wakify
keyPassword=CHANGE_ME
